// Problem: Valid Anagram (LeetCode 242)
// Pattern: Frequency Array
// Difficulty: Easy

// Intuition:
// Two strings are anagrams if every character appears
// the same number of times in both strings.
// Count characters of the first string,
// subtract counts using the second string,
// and finally verify that all frequencies become zero.

// Approach:
// 1. If lengths differ, return false.
// 2. Create a frequency array.
// 3. Increment frequencies for the first string.
// 4. Decrement frequencies for the second string.
// 5. If any frequency is not zero, return false.
// 6. Otherwise return true.

// Time Complexity: O(n)
// Space Complexity: O(1)

class Solution {
    public boolean isAnagram(String s, String t) {
        char[] a=s.toCharArray();
        char[] b=t.toCharArray();
        int[] freq=new int[256];
        if(a.length!=b.length) return false;
        for(int i=0;i<a.length;i++){
            freq[a[i]]++;
        }
        for(int i=0;i<a.length;i++){
            freq[b[i]]--;
        }
        for(int i=0;i<freq.length;i++){
            if(freq[i]!=0){
                return false;
            }
        }
        return true;
    }
}
