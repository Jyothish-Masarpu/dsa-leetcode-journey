// Problem: Search in Rotated Sorted Array II (LeetCode 81)
// Pattern: Binary Search
// Difficulty: Medium

// Intuition:
// In a rotated sorted array with duplicates, one half is usually sorted.
// When left, mid, and right are equal, we cannot determine which half is sorted,
// so remove the duplicate values from both ends.

// Approach:
// 1. Find the middle element.
// 2. If nums[mid] == target, return true.
// 3. If nums[low], nums[mid], and nums[high] are equal, shrink both ends.
// 4. Check whether the left half is sorted.
// 5. If target lies in the sorted left half, search left.
// 6. Otherwise, search right.
// 7. If the right half is sorted, check whether target lies inside it.
// 8. If target is not found, return false.

// Time Complexity: O(log n) average, O(n) worst case
// Space Complexity: O(1)

class Solution {
    public boolean search(int[] nums, int target) {
        int low=0,high=nums.length-1;
        while(low<=high){
            int mid=low+(high-low)/2;
            if(nums[mid]==target) return true;
            if(nums[low]==nums[mid] && nums[high]==nums[mid]){
                low++;
                high--;
            }
            else if(nums[low]<=nums[mid]){
                if(target>=nums[low] && target<nums[mid]){
                    high=mid-1;
                }else{
                    low=mid+1;
                }
            }
            else{
                if(target>nums[mid] && target<=nums[high]){
                    low=mid+1;
                }else{
                    high=mid-1;
                }
            }
        }
        return false;
    }
}
