// Problem: Sqrt(x) (LeetCode 69)
// Pattern: Binary Search
// Difficulty: Easy

// Intuition:
// Find the largest integer whose square is less than or equal to x.
// Binary Search is used because the values increase in sorted order.

// Approach:
// 1. Search from 1 to x / 2.
// 2. If mid * mid <= x, mid is valid, so search right.
// 3. Otherwise, search left.
// 4. When the search ends, right is the largest valid value.

// Time Complexity: O(log n)
// Space Complexity: O(1)

class Solution {
    public int mySqrt(int x) {
        if (x < 2)
            return x;
        int left = 1;
        int right = x / 2;
        while (left <= right) {
            int mid = left + (right - left) / 2;
            if (mid <= x / mid) {
                left = mid + 1;
            }
            else {
                right = mid - 1;
            }
        }
        return right;
    }
}
