// Problem: Search in Rotated Sorted Array (LeetCode 33)
// Pattern: Binary Search
// Difficulty: Medium

// Intuition:
// In a rotated sorted array, at least one half is always sorted.
// Check which half is sorted, then determine whether the target lies in that half.

// Approach:
// 1. Find the middle element.
// 2. If nums[mid] == target, return mid.
// 3. Check whether the left half is sorted.
// 4. If target lies inside the sorted left half, search left.
// 5. Otherwise, search right.
// 6. If the right half is sorted, check whether target lies inside it.
// 7. If target is not found, return -1.

// Time Complexity: O(log n)
// Space Complexity: O(1)

class Solution {
    public int search(int[] nums, int target) {
        int left=0,right=nums.length-1;
        while(left<=right){
            int mid=left+(right-left)/2;
            if(nums[mid]==target) return mid;
            else if(nums[left]<=nums[mid]){
                if(target>=nums[left] && target<nums[mid]){
                    right=mid-1;
                }
                else{
                    left=mid+1;
                }
            }
            else{
                if(target>nums[mid] && target<=nums[right]){
                    left=mid+1;
                }
                else{
                    right=mid-1;
                }
            }
        }
        return -1;
    }
}
