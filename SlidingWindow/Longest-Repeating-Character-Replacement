// Problem: Longest Repeating Character Replacement (LeetCode 424)
// Pattern: Variable Size Sliding Window + Frequency Array
// Difficulty: Medium

// Intuition:
// We need to find the longest substring that can be converted into
// a string of identical characters by replacing at most k characters.
// In every window, keep the most frequent character and replace all
// remaining characters.
// Replacements needed = Window Size - Maximum Frequency.
// If replacements exceed k, shrink the window.

// Approach:
// 1. Use two pointers (left and right) to maintain a sliding window.
// 2. Maintain a frequency array for all uppercase letters.
// 3. Track the maximum frequency (max) of any character in the current window.
// 4. If (windowSize - max) > k, shrink the window from the left.
// 5. Update the maximum valid window length.
// 6. Return the longest valid window.

// Time Complexity: O(n)
// Space Complexity: O(1)   // 26 uppercase English letters

class Solution {
    public int characterReplacement(String s, int k) {
        int ans = 0, max = 0, left = 0;
        int[] freq = new int[26];
        for (int right = 0; right < s.length(); right++) {
            char ch = s.charAt(right);
            freq[ch - 'A']++;
            max = Math.max(max, freq[ch - 'A']);
            while ((right - left + 1) - max > k) {
                freq[s.charAt(left) - 'A']--;
                left++;
            }
            ans = Math.max(ans, right - left + 1);
        }
        return ans;
    }
}
