// Follow-up: Return the actual longest substring instead of its length.

// Additional Idea:
// 1. Store the starting index of the longest window.
// 2. Whenever a longer window is found,
//    update maxLen and start.
// 3. Return s.substring(start, start + maxLen).

// Time Complexity: O(n)
// Space Complexity: O(k)

class Solution {
    public String longestSubstring(String s) {
        Map<Character, Integer> map = new HashMap<>();
        int left = 0;
        int maxLen = 0;
        int start = 0;
        for (int right = 0; right < s.length(); right++) {
            char ch = s.charAt(right);
            if (map.containsKey(ch)) {
                left = Math.max(left, map.get(ch) + 1);
            }
            map.put(ch, right);
            if (right - left + 1 > maxLen) {
                maxLen = right - left + 1;
                start = left;
            }
        }
        return s.substring(start, start + maxLen);
    }
}
