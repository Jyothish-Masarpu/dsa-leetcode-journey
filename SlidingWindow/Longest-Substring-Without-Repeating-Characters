// Problem: Longest Substring Without Repeating Characters (LeetCode 3)
// Pattern: Sliding Window + HashMap
// Difficulty: Medium

// Intuition:
// We need to find the length of the longest substring containing unique characters.
// Brute force (check all substrings) = O(n²) or O(n³) ❌
// Optimized approach: Sliding Window + HashMap

// Approach:
// 1. Use two pointers (left and right) to maintain a sliding window.
// 2. Store the last seen index of each character in a HashMap.
// 3. If the current character is already in the window,
//    move left to max(left, lastIndex + 1).
// 4. Update the current character's latest index.
// 5. Update the maximum window length.

// Time Complexity: O(n)
// Space Complexity: O(k)  // k = number of unique characters

class Solution {
    public int lengthOfLongestSubstring(String s) {
        Map<Character, Integer> map = new HashMap<>();
        int left = 0;
        int ans = 0;
        for (int right = 0; right < s.length(); right++) {
            char ch = s.charAt(right);
            if (map.containsKey(ch)) {
                left = Math.max(left, map.get(ch) + 1);
            }
            map.put(ch, right);
            ans = Math.max(ans, right - left + 1);
        }
        return ans;
    }
}
