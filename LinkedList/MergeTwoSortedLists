// Problem: Merge Two Sorted Lists (LeetCode 21)
// Pattern: Linked List / Two Pointers
// Difficulty: Easy

// Intuition:
// Use a dummy node and a temporary pointer to build the merged sorted list.
// Compare the current nodes of both lists and attach the smaller node.

// Approach:
// 1. Create a dummy node to simplify building the result list.
// 2. Use temp to track the last node of the merged list.
// 3. Compare the current nodes of list1 and list2.
// 4. Attach the smaller node to temp and move that list forward.
// 5. Move temp to the newly attached node.
// 6. Attach the remaining nodes after one list becomes null.
// 7. Return dummy.next as the head of the merged list.

// Time Complexity: O(n + m)
// Space Complexity: O(1)

class Solution {
    public ListNode mergeTwoLists(ListNode list1, ListNode list2) {
        ListNode dummy=new ListNode(0);
        ListNode temp=dummy;
        while(list1!=null && list2!=null){
            if(list1.val<=list2.val){
                temp.next=list1;
                list1=list1.next;
            }
            else{
                temp.next=list2;
                list2=list2.next;
            }
            temp=temp.next;
        }
        if(list1!=null) temp.next=list1;
        else temp.next=list2;
        return dummy.next;
    }
}
